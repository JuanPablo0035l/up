---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/photobooth.css";
import Footer from "../components/Footer.astro";

// Video path (place your video in public/videos/ folder)
const videoPath = "/videos/video_pro.mp4";
const staticImagePath = "/img/template-image-photobooth.jpeg";
---

<MainLayout title="360 Photobooth Pro | Experiencia Inmersiva">
    <!-- HERO -->
    <section class="hero-section">
        <h1 class="roadrunner-title">DESCUBRE NUESTRA 360</h1>
        <div class="scroll-wrapper">
            <div class="scroll-hint">
                Desliza para explorar <span class="arrow">↓</span>
            </div>
        </div>
    </section>

    <!-- EXPERIENCE PINNED AREA -->
    <section class="experience-container" id="pin-container">
        <!-- 1. VIDEO LAYER -->
        <div class="video-wrapper">
            <video
                id="scrolly-video"
                src={videoPath}
                muted
                playsinline
                preload="auto"
                class="main-video"
            >
                <source src={videoPath} type="video/mp4" />
            </video>
        </div>

        <!-- 2. STATIC IMAGE LAYER (Fades in after action) -->
        <div
            class="static-image-layer"
            style={`background-image: url('${staticImagePath}')`}
            role="img"
            aria-label="Plataforma 360 estática"
        >
        </div>

        <!-- 3. INFO LAYER (Bubbles) -->
        <div class="info-layer">
            <div class="content-grid">
                <div class="column left-col">
                    <div class="bubble bubble-left">
                        <h3>Tecnología 360</h3>
                        <p>
                            Captura inmersiva 4K de alta gama con estabilización
                            profesional.
                        </p>
                    </div>
                    <div class="bubble bubble-left">
                        <h3>Instantáneo</h3>
                        <p>
                            Captura, procesa y comparte en menos de 15 segundos.
                        </p>
                    </div>
                </div>

                <div class="center-col">
                    <!-- Hidden on mobile but keeps structure on desktop -->
                </div>

                <div class="column right-col">
                    <div class="bubble bubble-right right-side">
                        <h3>Slow Motion</h3>
                        <p>
                            Efectos cinematográficos fluidos para videos que
                            impactan.
                        </p>
                    </div>
                    <div class="bubble bubble-right right-side">
                        <h3>Comparte ya</h3>
                        <p>
                            Envío directo vía QR, AirDrop o WhatsApp al
                            instante.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACT & PRICING SECTION -->
    <section class="spacer">
        <h2>¿Listo para lo Pro?</h2>
        <p style="opacity: 0.7; margin-bottom: 2rem;">
            Hacemos que tu evento en San Andrés sea inolvidable.
        </p>

        <button id="cta-cotizar" class="cta-button"> Cotizar Evento </button>

        <div id="pricing-container" class="pricing-hidden">
            <div class="pricing-grid">
                <!-- BASIC -->
                <div class="price-card">
                    <div class="badge">Básico</div>
                    <h3>Plan Básico</h3>
                    <ul>
                        <li>
                            <i class="fas fa-clock"></i> 1 Hora: <strong
                                >$270.000</strong
                            >
                        </li>
                        <li>
                            <i class="fas fa-clock"></i> 2 Horas: <strong
                                >$320.000</strong
                            >
                        </li>
                        <li>
                            <i class="fas fa-clock"></i> 3 Horas: <strong
                                >$420.000</strong
                            >
                        </li>
                    </ul>
                    <p class="note">Sin iluminación ni props</p>
                    <a
                        href="https://wa.me/573210000000?text=Hola!%20Me%20interesa%20el%20Plan%20Básico"
                        class="btn-wa">Reservar por WhatsApp</a
                    >
                </div>

                <!-- VIP -->
                <div class="price-card vip">
                    <div class="badge">Recomendado</div>
                    <h3>Plan FULL</h3>
                    <ul>
                        <li>
                            <i class="fas fa-clock"></i> 1 Hora: <strong
                                >$350.000</strong
                            >
                        </li>
                        <li>
                            <i class="fas fa-clock"></i> 2 Horas: <strong
                                >$480.000</strong
                            >
                        </li>
                        <li>
                            <i class="fas fa-clock"></i> 3 Horas: <strong
                                >$600.000</strong
                            >
                        </li>
                    </ul>
                    <p class="note">Incluye Iluminación + Props (Obsequio)</p>
                    <a
                        href="https://wa.me/573210000000?text=Hola!%20Me%20interesa%20el%20Plan%20VIP"
                        class="btn-wa">Reservar por WhatsApp</a
                    >
                </div>
            </div>

            <div class="corporate-banner">
                <div class="corp-content">
                    <h3>¿Evento de más de 3 horas?</h3>
                    <p>
                        Solución ideal para Empresas y Congresos en San Andrés.
                    </p>
                    <form class="corporate-form">
                        <input
                            type="text"
                            placeholder="Nombre de la Empresa"
                            required
                        />
                        <input
                            type="email"
                            placeholder="Email de contacto"
                            required
                        />
                        <textarea
                            placeholder="Cuéntanos sobre tu evento..."
                            rows="3"></textarea>
                        <button type="submit" class="btn-submit"
                            >Enviar solicitud corporativa</button
                        >
                    </form>
                    <p class="wa-direct">
                        O hablemos ahora: <a href="https://wa.me/573210000000"
                            >WhatsApp Directo</a
                        >
                    </p>
                </div>
            </div>
        </div>
    </section>

    <Footer />

    <script>
        import { init360Experience } from "../scripts/photobooth.js";
        init360Experience();

        import { setupScrollAnimation } from "../scripts/animacionFlecha.js";
        setupScrollAnimation();

        // 1. Toggle Pricing Section
        const ctaBtn = document.getElementById("cta-cotizar");
        const pricingContainer = document.getElementById("pricing-container");

        if (ctaBtn && pricingContainer) {
            ctaBtn.addEventListener("click", () => {
                pricingContainer.classList.toggle("pricing-hidden");
                pricingContainer.classList.toggle("pricing-visible");

                if (pricingContainer.classList.contains("pricing-visible")) {
                    pricingContainer.scrollIntoView({ behavior: "smooth" });
                }
            });
        }

        // 2. Form Submission (Simulated)
        const form = document.querySelector(".corporate-form");
        if (form) {
            form.addEventListener("submit", (e) => {
                e.preventDefault();
                alert(
                    "¡Gracias! Hemos recibido tu solicitud corporativa. Te contactaremos en menos de 24 horas.",
                );
                const corporateForm = form as HTMLFormElement;
                corporateForm.reset();
            });
        }
    </script>
</MainLayout>
