---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/photobooth.css";
import Footer from "../components/Footer.astro";

// Video path (place your video in public/videos/ folder)
const videoPath = "/videos/video_pro.mp4";
const staticImagePath = "/img/template-image-photobooth.jpeg";
---

<MainLayout
    title="360 Photobooth Pro | Experiencia Inmersiva"
    description="Alquiler de fotocabinas 360 en San Andrés Isla. Plataforma 360 Photobooth profesional para eventos, bodas y fiestas. Tecnología inmersiva 4K con entrega instantánea."
    keywords="ALQUILER DE FOTOCABINAS EN SAN ANDRES ISLA, 360 PHOTOBOOTH SAN ANDRES, 360 PLATAFORMA, fotocabina 360 san andres, alquiler photobooth san andres isla, plataforma 360 eventos, photobooth profesional san andres"
>
    <!-- HERO -->
    <section class="hero-section">
        <h1 class="roadrunner-title">DESCUBRE NUESTRA 360</h1>
        <div class="scroll-wrapper">
            <div class="scroll-hint">
                Desliza para explorar <span class="arrow">↓</span>
            </div>
        </div>
    </section>

    <!-- EXPERIENCE PINNED AREA -->
    <section class="experience-container" id="pin-container">
        <!-- 1. VIDEO LAYER -->
        <div class="video-wrapper">
            <video
                id="scrolly-video"
                src={videoPath}
                muted
                playsinline
                preload="auto"
                class="main-video"
            >
                <source src={videoPath} type="video/mp4" />
            </video>
        </div>

        <!-- 2. STATIC IMAGE LAYER (Fades in after action) -->
        <div
            class="static-image-layer"
            style={`background-image: url('${staticImagePath}')`}
            role="img"
            aria-label="Plataforma 360 estática"
        >
        </div>

        <!-- 3. INFO LAYER (Bubbles) -->
        <div class="info-layer">
            <div class="content-grid">
                <div class="column left-col">
                    <div class="bubble bubble-left">
                        <h3>Tecnología 360</h3>
                        <p>
                            Captura inmersiva 4K de alta gama con estabilización
                            profesional.
                        </p>
                    </div>
                    <div class="bubble bubble-left">
                        <h3>Instantáneo</h3>
                        <p>
                            Captura, procesa y comparte en menos de 15 segundos.
                        </p>
                    </div>
                </div>

                <div class="center-col">
                    <!-- Hidden on mobile but keeps structure on desktop -->
                </div>

                <div class="column right-col">
                    <div class="bubble bubble-right right-side">
                        <h3>Slow Motion</h3>
                        <p>
                            Efectos cinematográficos fluidos para videos que
                            impactan.
                        </p>
                    </div>
                    <div class="bubble bubble-right right-side">
                        <h3>Comparte ya</h3>
                        <p>
                            Envío directo vía QR, AirDrop o WhatsApp al
                            instante.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- PLAN & PRICING SECTION -->
    <section class="spacer" id="plan-experiencia">
        <h2>
            Plan Experiencia 360° <span
                style="display:block; font-size: 0.5em; opacity: 0.7; font-weight: 400; margin-top: 8px;"
                >Todo Incluido — Sin sorpresas</span
            >
        </h2>

        <div class="pricing-grid" style="margin-top: 2rem;">
            <!-- SINGLE PREMIUM PLAN -->
            <div class="price-card vip">
                <div class="badge">Todo Incluido</div>
                <h3>Experiencia 360°</h3>
                <ul class="plan-features">
                    <li>
                        <i class="fas fa-check"></i> Plataforma 360° profesional
                    </li>
                    <li>
                        <i class="fas fa-check"></i> Iluminación LED infinity mirror
                    </li>
                    <li>
                        <i class="fas fa-check"></i> Props premium (gafas, sombreros,
                        letreros)
                    </li>
                    <li><i class="fas fa-check"></i> Máquina de burbujas</li>
                    <li>
                        <i class="fas fa-check"></i> Staff durante todo el evento
                    </li>
                    <li><i class="fas fa-check"></i> Transporte incluido</li>
                    <li>
                        <i class="fas fa-check"></i> Videos 4K en cámara lenta
                    </li>
                    <li>
                        <i class="fas fa-check"></i> Entrega instantánea por QR
                    </li>
                </ul>

                <div class="price-tiers">
                    <div class="price-row">
                        <span class="tier-duration"
                            ><i class="fas fa-clock"></i> 1 Hora</span
                        >
                        <strong class="tier-price">$350.000</strong>
                    </div>
                    <div class="price-row featured">
                        <span class="tier-duration"
                            ><i class="fas fa-clock"></i> 2 Horas</span
                        >
                        <strong class="tier-price">$500.000</strong>
                        <span class="best-value">Más popular</span>
                    </div>
                    <div class="price-row">
                        <span class="tier-duration"
                            ><i class="fas fa-clock"></i> 3 Horas</span
                        >
                        <strong class="tier-price">$650.000</strong>
                    </div>
                    <div class="price-row extra">
                        <span class="tier-duration"
                            ><i class="fas fa-plus-circle"></i> Hora extra</span
                        >
                        <strong class="tier-price">$150.000</strong>
                    </div>
                </div>

                <a
                    href="https://wa.me/573210000000?text=Hola!%20Quiero%20reservar%20la%20Experiencia%20360%20para%20mi%20evento"
                    class="btn-wa">Reservar por WhatsApp</a
                >
            </div>
        </div>

        <div class="corporate-banner">
            <div class="corp-content">
                <h3>¿Evento corporativo o de más de 3 horas?</h3>
                <p>
                    Solución ideal para empresas, congresos y bodas grandes en
                    San Andrés. Cotización personalizada según tus necesidades.
                </p>
                <a
                    href="https://wa.me/573210000000?text=Hola!%20Necesito%20cotizar%20un%20evento%20corporativo%20con%20la%20360"
                    class="btn-wa"
                    style="margin-top: 1rem; display: inline-flex;"
                >
                    <i class="fab fa-whatsapp"></i> Cotizar Evento Corporativo
                </a>
            </div>
        </div>
    </section>

    <Footer />

    <script>
        import { init360Experience } from "../scripts/photobooth.js";
        init360Experience();

        import { setupScrollAnimation } from "../scripts/animacionFlecha.js";
        setupScrollAnimation();
    </script>
</MainLayout>
