---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/home.css";
import "../styles/lines-effect.css";
import HowItWorks from "../components/HowItWorks.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import ScrollyTelling from "../components/ScrollyTelling.astro";
---

<MainLayout title="Up Party Rentals - Inicio">
    <!-- BAND 1: HERO SECTION -->
    <section class="hero-section">
        <div class="hero-bg"></div>
        <div class="section-content">
            <div class="hero-details">
                <h1 class="title">
                    <div>TU EVENTO CON</div>
                    <div>VIDEOS 360°</div>
                </h1>
                <h2 class="subtitle">QUE TODOS VAN A COMPARTIR</h2>
                <p class="description">
                    Tus invitados se graban en cámara lenta, reciben su video en
                    15 segundos y lo comparten en redes. Tu evento se vuelve
                    inolvidable.
                </p>
                <div class="buttons">
                    <a href="/photobooth#plan-experiencia" class="button Agenda"
                        >VER PLAN Y PRECIO →</a
                    >
                    <a
                        href="https://wa.me/573210000000?text=Hola!%20Quiero%20info%20sobre%20la%20360%20para%20mi%20evento"
                        class="button ghost"
                        style="border-color: white; color: white;"
                        >PREGUNTAR POR WHATSAPP</a
                    >
                </div>
            </div>

            <div class="mascot-container" id="mascot-3d">
                <div class="mascot-tooltip">
                    <i class="fas fa-palm-tree" style="color: #2db84c;"></i> Expertos
                    en Eventos <br />
                    en San Andrés. <br />
                    <span class="highlight"
                        >Equipo 2026 <span class="badge-new">Nuevo</span></span
                    >
                </div>
                <model-viewer
                    src="/models/Meshy_AI_Violet_Robo_0211220642_texture.glb"
                    alt="Up Party Mascot"
                    auto-rotate
                    camera-controls
                    shadow-intensity="1"
                    exposure="1.4"
                    environment-image="neutral"
                    loading="eager"
                    disable-zoom
                    style="width: 100%; height: 220px; background: transparent; --poster-color: transparent;"
                ></model-viewer>
            </div>
        </div>
    </section>

    <!-- BAND 2: VIDEO BANNER (Horizontal Separation) -->
    <section class="video-section">
        <video autoplay muted loop playsinline>
            <source
                src="/videos/360 Photo Booth Rental in Chicago, IL.mp4"
                type="video/mp4"
            />
        </video>
    </section>

    <!-- BAND 3: IMPACT SECTION (Now as a defined band) -->
    <section class="section-band impact-section">
        <div class="impact-bg"></div>
        <div class="impact-overlay"></div>
        <div class="impact-content">
            <h2 class="impact-title">PLATAFORMA 360</h2>
            <p
                style="color: white; margin-bottom: 2rem; font-size: 1.2rem; opacity: 0.9;"
            >
                LA TECNOLOGÍA QUE TU EVENTO MERECE
            </p>
            <a
                href="/fiestas-y-eventos"
                class="button ghost"
                style="border-color: white; color: white;">CONOCE MÁS</a
            >
        </div>
    </section>

    <!-- BAND 4: 50/50 SPLIT (Vibrant Gradient) -->
    <section class="section-band section-vibrant">
        <div class="split-container">
            <div class="split-side">
                <div class="split-image-container">
                    <div class="split-carousel-track" id="splitTrack">
                        <img
                            src="/img/360-photo-booth-pro-automatic-infinity-mirror-360-camera-booth-360-video-booth-24.jpg"
                            alt="Plataforma 360"
                        />
                        <img
                            src="https://www.shutterstock.com/shutterstock/photos/2528409143/display_1500/stock-photo-a-degree-photo-booth-setup-with-led-lights-and-a-rotating-platform-surrounded-by-floral-2528409143.jpg"
                            alt="Evento 1"
                        />
                        <img
                            src="https://www.visioncaptis.com/cdn/shop/files/WhatsAppImage2024-10-12at12.46.16_1.jpg?v=1728753178&width=1445"
                            alt="Evento 2"
                        />
                    </div>

                    <button
                        class="split-nav-btn prev"
                        id="splitPrev"
                        aria-label="Anterior"
                    >
                        <svg viewBox="0 0 24 24"
                            ><path
                                d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"
                            ></path></svg
                        >
                    </button>
                    <button
                        class="split-nav-btn next"
                        id="splitNext"
                        aria-label="Siguiente"
                    >
                        <svg viewBox="0 0 24 24"
                            ><path
                                d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                            ></path></svg
                        >
                    </button>

                    <div class="split-dots" id="splitDots"></div>
                </div>
            </div>
            <div class="split-side">
                <h2 class="title">MODERNIDAD &<br />DIVERSIÓN</h2>
                <p class="text">
                    No es solo una foto, es una experiencia 360 inmersiva.
                    Nuestras plataformas cuentan con iluminación LED infinity
                    mirror y tecnología de última generación para capturas en
                    cámara lenta que se comparten al instante.
                </p>
                <a
                    href="/photobooth"
                    class="button ghost"
                    style="border-color: white; color: white;">VER DETALLES</a
                >
            </div>
        </div>
    </section>

    <!-- BAND 5: VERTICAL SCROLL EXPERIENCE (Scrollytelling) -->
    <ScrollyTelling />

    <!-- TRUST SECTION: Credenciales reales -->
    <section class="section-band trust-section">
        <div class="section-content">
            <h2 class="trust-title">¿Por qué elegirnos?</h2>
            <div class="trust-grid">
                <div class="trust-card">
                    <div class="trust-icon"><i class="fas fa-video"></i></div>
                    <h3>Equipo Profesional 4K</h3>
                    <p>
                        Tecnología de gama alta para resultados cinematográficos
                    </p>
                </div>
                <div class="trust-card">
                    <div class="trust-icon"><i class="fas fa-bolt"></i></div>
                    <h3>Video Listo en 15 seg</h3>
                    <p>Tus invitados lo descargan y comparten al instante</p>
                </div>
                <div class="trust-card">
                    <div class="trust-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h3>Todo Incluido</h3>
                    <p>Luces, props, staff y transporte. Sin costos ocultos</p>
                </div>
                <div class="trust-card">
                    <div class="trust-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h3>1 Evento por Día</h3>
                    <p>Atención 100% dedicada a tu celebración</p>
                </div>
            </div>
        </div>
    </section>

    <HowItWorks />

    <!-- URGENCY BAR -->
    <section class="urgency-bar">
        <div class="urgency-content">
            <i class="fas fa-calendar-alt"></i>
            <p>
                <strong>Agenda limitada</strong> — Solo atendemos 1 evento por día
                en San Andrés. <a href="/photobooth#plan-experiencia"
                    >Reserva tu fecha →</a
                >
            </p>
        </div>
    </section>

    <FAQ />
    <Footer />

    <style>
        /* 1. Aseguramos que el título sea visible y tenga el comportamiento correcto */
        .hero-section .hero-details .title {
            /* Necesario para que las letras puedan "volar" fuera del área del texto */
            overflow: visible !important;
        }

        /* 2. REGLA DE ORO PARA EL GRADIENTE + SPLITTEXT */
        :global(.hero-section .hero-details .title div) {
            display: inline-block !important;
            color: var(--text-color); /* Ensure text is visible */
            /* Mantiene la alineación vertical correcta */
            vertical-align: middle;
        }
    </style>

    <script>
        import { setupScrollReveal } from "../scripts/scrollReveal.js";
        import { initHighEndAnimations } from "../scripts/interactive.js";
        import { initCarousels } from "../scripts/carousel.js";

        const initPage = () => {
            setupScrollReveal();
            initHighEndAnimations();
            initCarousels();
        };

        document.addEventListener("DOMContentLoaded", initPage);
        document.addEventListener("astro:after-swap", initPage);
    </script>
</MainLayout>
