---
import MainLayout from "../layouts/MainLayout.astro";
import Footer from "../components/Footer.astro";
---

<MainLayout title="Galería de Experiencias | Up Party Rentals">
    <section class="gallery-hero">
        <h1 class="gallery-title">
            NUESTROS <span class="highlight">MOMENTOS</span>
        </h1>
        <p class="gallery-subtitle">
            Capturando la magia de cada evento en San Andrés
        </p>
    </section>

    <section class="gallery-grid-container">
        <div class="gallery-grid">
            <!-- Placeholders for future photos -->
            {
                [1, 2, 3, 4, 5, 6, 7, 8, 9].map((i) => (
                    <div class="gallery-item">
                        <div class="image-placeholder">
                            <i class="fas fa-camera" />
                            <span>Próximamente</span>
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <Footer />
</MainLayout>

<style>
    .gallery-hero {
        padding: 150px 20px 60px;
        text-align: center;
        background: radial-gradient(
            circle at center,
            rgba(120, 62, 140, 0.1) 0%,
            transparent 70%
        );
    }

    .gallery-title {
        font-family: "bbh", sans-serif;
        font-size: clamp(2.5rem, 8vw, 5rem);
        margin-bottom: 20px;
        letter-spacing: -0.02em;
    }

    .gallery-subtitle {
        font-size: 1.2rem;
        opacity: 0.7;
        max-width: 600px;
        margin: 0 auto;
    }

    .gallery-grid-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 60px 20px 120px;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 30px;
    }

    .gallery-item {
        aspect-ratio: 4/5;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        overflow: hidden;
        position: relative;
        cursor: pointer;
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .gallery-item:hover {
        transform: translateY(-10px) scale(1.02);
        border-color: var(--neon-secondary);
        box-shadow: 0 20px 40px rgba(120, 62, 140, 0.2);
    }

    .image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 15px;
        color: rgba(255, 255, 255, 0.2);
    }

    .image-placeholder i {
        font-size: 3rem;
    }

    .image-placeholder span {
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.8rem;
    }

    .highlight {
        color: var(--neon-secondary);
        text-shadow: 0 0 20px rgba(254, 19, 187, 0.4);
    }

    @media (max-width: 768px) {
        .gallery-hero {
            padding-top: 120px;
        }
        .gallery-grid {
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // Entrance Animation
    gsap.from(".gallery-item", {
        opacity: 0,
        y: 50,
        duration: 1,
        stagger: 0.1,
        ease: "power3.out",
        scrollTrigger: {
            trigger: ".gallery-grid",
            start: "top 80%",
        },
    });

    // Parallax effect on grid items
    gsap.utils.toArray(".gallery-item").forEach((item: any, i) => {
        gsap.to(item, {
            y: i % 2 === 0 ? -30 : 30,
            ease: "none",
            scrollTrigger: {
                trigger: item,
                start: "top bottom",
                end: "bottom top",
                scrub: 1,
            },
        });
    });
</script>
