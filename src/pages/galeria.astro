---
import MainLayout from "../layouts/MainLayout.astro";
import Footer from "../components/Footer.astro";
---

<MainLayout title="Galería de Experiencias | Up Party Rentals">
    <section class="gallery-hero">
        <h1 class="gallery-title">
            NUESTROS <span class="highlight">MOMENTOS</span>
        </h1>
        <p class="gallery-subtitle">
            Capturando la magia de cada evento en San Andrés
        </p>
    </section>

    <section class="gallery-grid-container">
        <div class="gallery-grid">
            <div class="gallery-item">
                <img
                    src="https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?q=80&w=800&auto=format&fit=crop"
                    alt="Evento con luces y ambiente de fiesta"
                    loading="lazy"
                />
            </div>
            <div class="gallery-item">
                <img
                    src="/img/360-photo-booth-pro-automatic-infinity-mirror-360-camera-booth-360-video-booth-24.jpg"
                    alt="Plataforma 360 con espejo infinity"
                    loading="lazy"
                />
            </div>
            <div class="gallery-item">
                <img
                    src="https://www.shutterstock.com/shutterstock/photos/2528409143/display_1500/stock-photo-a-degree-photo-booth-setup-with-led-lights-and-a-rotating-platform-surrounded-by-floral-2528409143.jpg"
                    alt="Photobooth 360 con decoración floral"
                    loading="lazy"
                />
            </div>
            <div class="gallery-item">
                <img
                    src="https://www.shutterstock.com/shutterstock/photos/2414591175/display_1500/stock-photo-riga-latvia-december-person-standing-on-a-degree-photo-booth-platform-often-2414591175.jpg"
                    alt="Persona en la plataforma 360"
                    loading="lazy"
                />
            </div>
            <div class="gallery-item">
                <img
                    src="https://images.unsplash.com/photo-1765947390055-c5187b491ba0?q=80&w=687&auto=format&fit=crop"
                    alt="Equipo profesional de photobooth"
                    loading="lazy"
                />
            </div>
            <div class="gallery-item">
                <img
                    src="https://www.visioncaptis.com/cdn/shop/files/WhatsAppImage2024-10-12at12.46.16_1.jpg?v=1728753178&width=1445"
                    alt="Montaje de plataforma 360 en evento"
                    loading="lazy"
                />
            </div>
        </div>

        <div class="gallery-cta">
            <p>¿Quieres esto en tu evento?</p>
            <a href="/photobooth#plan-experiencia" class="gallery-btn"
                >Ver Plan y Precio →</a
            >
        </div>
    </section>

    <Footer />
</MainLayout>

<style>
    .gallery-hero {
        padding: 150px 20px 60px;
        text-align: center;
        background: radial-gradient(
            circle at center,
            rgba(120, 62, 140, 0.1) 0%,
            transparent 70%
        );
    }

    .gallery-title {
        font-family: "bbh", sans-serif;
        font-size: clamp(2.5rem, 8vw, 5rem);
        margin-bottom: 20px;
        letter-spacing: -0.02em;
    }

    .gallery-subtitle {
        font-size: 1.2rem;
        opacity: 0.7;
        max-width: 600px;
        margin: 0 auto;
    }

    .gallery-grid-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 60px 20px 80px;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 30px;
    }

    .gallery-item {
        aspect-ratio: 4/5;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        overflow: hidden;
        position: relative;
        cursor: pointer;
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .gallery-item:hover {
        transform: translateY(-10px) scale(1.02);
        border-color: var(--neon-secondary);
        box-shadow: 0 20px 40px rgba(120, 62, 140, 0.2);
    }

    .gallery-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .gallery-item:hover img {
        transform: scale(1.05);
    }

    .gallery-cta {
        text-align: center;
        margin-top: 60px;
    }

    .gallery-cta p {
        font-size: 1.3rem;
        opacity: 0.7;
        margin-bottom: 20px;
    }

    .gallery-btn {
        display: inline-block;
        background: var(
            --brand-gradient,
            linear-gradient(135deg, #ff0055, #783e8c)
        );
        color: white;
        padding: 18px 45px;
        border-radius: 60px;
        text-decoration: none;
        font-weight: 700;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(254, 19, 187, 0.3);
    }

    .gallery-btn:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(254, 19, 187, 0.5);
    }

    .highlight {
        color: var(--neon-secondary);
        text-shadow: 0 0 20px rgba(254, 19, 187, 0.4);
    }

    @media (max-width: 768px) {
        .gallery-hero {
            padding-top: 120px;
        }
        .gallery-grid {
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // Entrance Animation
    gsap.from(".gallery-item", {
        opacity: 0,
        y: 50,
        duration: 1,
        stagger: 0.1,
        ease: "power3.out",
        scrollTrigger: {
            trigger: ".gallery-grid",
            start: "top 80%",
        },
    });

    // Parallax effect on grid items
    gsap.utils.toArray(".gallery-item").forEach((item: any, i) => {
        gsap.to(item, {
            y: i % 2 === 0 ? -30 : 30,
            ease: "none",
            scrollTrigger: {
                trigger: item,
                start: "top bottom",
                end: "bottom top",
                scrub: 1,
            },
        });
    });
</script>
