<style>
    /* ═══════════════════════════════════════════════
   SCROLLYTELLING — GLOBAL
   ═══════════════════════════════════════════════ */
    .st-wrapper {
        width: 100%;
        position: relative;
        z-index: 1;
    }

    /* ── EACH SCREEN ── */
    .st-screen {
        position: relative;
        width: 100%;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    /* ═══════════════════════════════════════════════
   BACKGROUNDS
   ═══════════════════════════════════════════════ */
    .st-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        background-size: cover;
        background-position: center;
    }
    .st-bg--img {
        /* handled via inline style */
    }
    .st-bg--gradient {
        background: linear-gradient(
            135deg,
            #7b2fbe 0%,
            #bf00ff 30%,
            #fe13bb 70%,
            #ff6b9d 100%
        );
        background-size: 300% 300%;
        animation: stGradientShift 8s ease-in-out infinite alternate;
    }
    @keyframes stGradientShift {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }

    .st-bg-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* ── OVERLAYS ── */
    .st-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            rgba(0, 0, 0, 0.7) 0%,
            rgba(0, 0, 0, 0.4) 40%,
            rgba(0, 0, 0, 0.6) 100%
        );
        z-index: 1;
    }
    .st-overlay--pink {
        background: linear-gradient(
            135deg,
            rgba(191, 0, 255, 0.4) 0%,
            rgba(0, 0, 0, 0.6) 50%,
            rgba(254, 19, 187, 0.3) 100%
        );
    }

    /* ═══════════════════════════════════════════════
   LAYOUT: TWO COLUMNS (Desktop) / STACKED (Mobile)
   ═══════════════════════════════════════════════ */
    .st-layout {
        position: relative;
        z-index: 5;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 30px;
        display: flex;
        align-items: center;
        gap: 60px;
        min-height: 100vh;
        box-sizing: border-box;
    }
    .st-layout--reverse {
        flex-direction: row-reverse;
    }
    .st-layout--center {
        justify-content: center;
    }

    .st-col {
        flex: 1;
        min-width: 0;
    }

    /* ── MEDIA COLUMN ── */
    .st-col--media {
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .st-float-img {
        width: 100%;
        max-width: 420px;
        height: auto;
        filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.5));
        border-radius: 8px;
    }
    .st-float-img--rounded {
        border-radius: 20px;
        border: 2px solid rgba(255, 255, 255, 0.15);
        box-shadow:
            0 20px 60px rgba(191, 0, 255, 0.2),
            0 0 0 1px rgba(255, 255, 255, 0.05);
    }

    /* ── TEXT COLUMN ── */
    .st-col--text {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .st-col--text-center {
        align-items: center;
        text-align: center;
    }

    /* ═══════════════════════════════════════════════
   TYPOGRAPHY
   ═══════════════════════════════════════════════ */
    .st-badge {
        display: inline-block;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 6px 18px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.9);
        width: fit-content;
    }
    .st-badge--pink {
        border-color: rgba(254, 19, 187, 0.4);
        color: #fe13bb;
    }
    .st-badge--cyan {
        border-color: rgba(0, 242, 255, 0.4);
        color: #00f2ff;
    }

    .st-title {
        font-family: var(--font-heading, "Archivo Black", sans-serif);
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 900;
        color: #fff;
        line-height: 1.05;
        text-transform: uppercase;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    }
    .st-title--large {
        font-size: clamp(2.5rem, 6vw, 5rem);
    }

    .st-accent {
        color: #fe13bb;
        text-shadow: 0 0 30px rgba(254, 19, 187, 0.4);
    }
    .st-accent--pink {
        color: #fe13bb;
        text-shadow: 0 0 30px rgba(254, 19, 187, 0.5);
    }
    .st-accent--cyan {
        color: #00f2ff;
        text-shadow: 0 0 30px rgba(0, 242, 255, 0.5);
    }

    .st-subtitle {
        font-size: clamp(1rem, 1.8vw, 1.3rem);
        color: rgba(255, 255, 255, 0.85);
        line-height: 1.7;
        max-width: 520px;
    }

    /* ═══════════════════════════════════════════════
   CTA BUTTON
   ═══════════════════════════════════════════════ */
    .st-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: #25d366;
        color: #fff;
        font-weight: 800;
        font-size: clamp(1rem, 2vw, 1.25rem);
        padding: 18px 44px;
        border-radius: 60px;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow:
            0 8px 30px rgba(37, 211, 102, 0.4),
            0 0 0 4px rgba(37, 211, 102, 0.15);
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
        margin-top: 20px;
    }
    .st-cta-btn:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow:
            0 14px 40px rgba(37, 211, 102, 0.5),
            0 0 0 6px rgba(37, 211, 102, 0.2);
    }
    .st-cta-btn svg {
        flex-shrink: 0;
    }

    /* ═══════════════════════════════════════════════
   MASCOT (Fixed Position – shown via JS)
   ═══════════════════════════════════════════════ */
    .st-mascot {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 180px;
        height: 180px;
        z-index: 100;
        pointer-events: none;
        opacity: 0;
        transform: translateY(60px) scale(0.8);
        transition:
            opacity 0.6s ease,
            transform 0.6s ease;
        filter: drop-shadow(0 0 15px rgba(191, 0, 255, 0.4));
    }
    .st-mascot.visible {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    /* ═══════════════════════════════════════════════
   TABLET RESPONSIVE  (769–1024px)
   ═══════════════════════════════════════════════ */
    @media screen and (min-width: 769px) and (max-width: 1024px) {
        .st-layout {
            gap: 30px;
            padding: 40px 20px;
            max-width: 95%;
        }
        .st-float-img {
            max-width: 300px;
        }
        .st-title {
            font-size: clamp(1.8rem, 4vw, 3rem);
        }
        .st-title--large {
            font-size: clamp(2rem, 5vw, 3.5rem);
        }
        .st-subtitle {
            font-size: clamp(0.95rem, 1.5vw, 1.15rem);
        }
        .st-mascot {
            width: 140px;
            height: 140px;
            bottom: 20px;
            right: 15px;
        }
        .st-cta-btn {
            padding: 16px 36px;
            font-size: 1rem;
        }
    }

    /* ═══════════════════════════════════════════════
   MOBILE RESPONSIVE  (≤ 768px)
   ═══════════════════════════════════════════════ */
    @media screen and (max-width: 768px) {
        .st-layout,
        .st-layout--reverse {
            flex-direction: column !important;
            text-align: center;
            gap: 30px;
            padding: 80px 20px 60px;
            justify-content: center;
        }
        .st-col--media {
            order: -1; /* Image first on mobile */
        }
        .st-col--text {
            align-items: center;
        }
        .st-float-img {
            max-width: 220px;
        }
        .st-subtitle {
            max-width: 100%;
        }
        .st-mascot {
            width: 120px;
            height: 120px;
            bottom: 20px;
            right: 10px;
        }
        .st-cta-btn {
            padding: 16px 30px;
            font-size: 0.95rem;
        }
    }

    /* ═════ SMALL PHONES (≤ 420px) ═════ */
    @media screen and (max-width: 420px) {
        .st-title {
            font-size: 1.8rem;
        }
        .st-title--large {
            font-size: 2rem;
        }
        .st-float-img {
            max-width: 160px;
        }
        .st-mascot {
            width: 90px;
            height: 90px;
            bottom: 10px;
            right: 5px;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // Fires on initial load AND Astro page transitions
    document.addEventListener("DOMContentLoaded", initScrollyTelling);
    document.addEventListener("astro:page-load", initScrollyTelling);

    function initScrollyTelling() {
        const wrapper = document.getElementById("stWrapper");
        const mascot = document.getElementById("stMascot");
        const screens = wrapper?.querySelectorAll(".st-screen");

        if (!wrapper || !mascot || !screens || screens.length === 0) return;

        // ── 1. SHOW / HIDE MASCOT when inside the wrapper ──
        ScrollTrigger.create({
            trigger: wrapper,
            start: "top 80%",
            end: "bottom 20%",
            onEnter: () => mascot.classList.add("visible"),
            onEnterBack: () => mascot.classList.add("visible"),
            onLeave: () => mascot.classList.remove("visible"),
            onLeaveBack: () => mascot.classList.remove("visible"),
        });

        // ── 2. PER-SCREEN ANIMATIONS ──
        screens.forEach((screen, i) => {
            const title = screen.querySelector(".st-title");
            const subtitle = screen.querySelector(".st-subtitle");
            const badge = screen.querySelector(".st-badge");
            const img = screen.querySelector(".st-float-img");
            const btn = screen.querySelector(".st-cta-btn");

            // Text reveal
            const textEls = [badge, title, subtitle, btn].filter(Boolean);
            if (textEls.length) {
                gsap.fromTo(
                    textEls,
                    { y: 40, opacity: 0 },
                    {
                        y: 0,
                        opacity: 1,
                        duration: 0.8,
                        stagger: 0.15,
                        ease: "power3.out",
                        scrollTrigger: {
                            trigger: screen,
                            start: "top 65%",
                            toggleActions: "play none none reverse",
                        },
                    },
                );
            }

            // Image reveal (scale + fade)
            if (img) {
                gsap.fromTo(
                    img,
                    { scale: 0.85, opacity: 0 },
                    {
                        scale: 1,
                        opacity: 1,
                        duration: 1,
                        ease: "back.out(1.4)",
                        scrollTrigger: {
                            trigger: screen,
                            start: "top 60%",
                            toggleActions: "play none none reverse",
                        },
                    },
                );
            }

            // ── 3. MASCOT REACTION per section ──
            ScrollTrigger.create({
                trigger: screen,
                start: "top center",
                end: "bottom center",
                onEnter: () => reactMascot(i, mascot),
                onEnterBack: () => reactMascot(i, mascot),
            });
        });
    }

    function reactMascot(index: number, el: HTMLElement) {
        // Kill previous reaction tweens (not opacity)
        gsap.killTweensOf(el, "rotation,scale,x,y");

        switch (index) {
            case 0: // Idle settle
                gsap.fromTo(
                    el,
                    { rotation: -10 },
                    { rotation: 0, duration: 0.6, ease: "elastic.out(1,0.5)" },
                );
                break;
            case 1: // 360° spin
                gsap.fromTo(
                    el,
                    { rotation: 0 },
                    { rotation: 360, duration: 1.2, ease: "power2.inOut" },
                );
                break;
            case 2: // Float up/down loop
                gsap.to(el, {
                    y: "-=20",
                    duration: 1.5,
                    yoyo: true,
                    repeat: -1,
                    ease: "sine.inOut",
                });
                break;
            case 3: // Big hello – scale up
                gsap.fromTo(
                    el,
                    { scale: 0.8 },
                    { scale: 1.3, duration: 0.6, ease: "back.out(2)" },
                );
                break;
        }
    }
</script>
